# Server
PORT=3000

# DeepSeek-OCR service (POST /ocr/extract)

# DeepSeek ASR (falls back to OPENAI_API_KEY when unset)
DEEPSEEK_API_KEY=
# DEEPSEEK_ASR_URL=https://api.deepseek.com/v1/tools/asr

# OpenAI-compatible chat API
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter (RLCD / Jev)
OPENROUTER_API_KEY=
OPENROUTER_RLCD_MODEL=typesafe/jev-latest
# Extraction model (reasoning disabled in code)
OPENROUTER_EXTRACT_MODEL=deepseek/deepseek-v4.1-flash
# Polish-capable embeddings
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3

# Storage: MySQL when set, JSON files in data/ otherwise
# MYSQL_URL=mysql://user:pass@host:3306/prawdowid

# Optional web search for evidence discovery (Brave or Tavily)
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Discord channel lives in a separate repository and calls POST /verify

# Jina Reader (optional: override endpoint / use an API key for higher rate limits)
# JINA_READER_URL=https://r.jina.ai/
# JINA_API_KEY=

# Google Fact Check Tools API (falls back to GOOGLE_API_KEY when unset)
GOOGLE_FACT_CHECK_API_KEY=
# Optional: moderator alert webhook for repeated unanswered questions
# MODERATOR_WEBHOOK_URL=
# GOOGLE_FACT_CHECK_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search

# EUvsDisinfo MCP — only for building the local snapshot (scripts/ingest-euvsdisinfo.ts).
# Runtime needs no token: it reads data/euvsdisinfo/cases.ndjson.
EUVD_TOKEN=
# EUVD_MCP_URL=https://euvsdisinfo-mcp-server.vercel.app/mcp
EUVD_LIMIT=2000
