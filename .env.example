# Copy this file to .env and adjust the values as needed.

# HTTP port the API listens on.
PORT=3000

# Optional. Set to a Redis/Valkey URL for the cache and short-lived task snapshots.
# Leave empty to keep both in memory.
# Example: redis://localhost:6379
REDIS_URL=

# DeepSeek direct API: chat completions and optional ASR.
# Leave empty to use the local heuristic/extractive fallbacks.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Peak cache-miss input and output rates, used for per-task cost tracking.
DEEPSEEK_INPUT_USD_PER_1M_TOKENS=0.30
DEEPSEEK_OUTPUT_USD_PER_1M_TOKENS=1.20
# DeepSeek ASR list price per hour of audio.
DEEPSEEK_ASR_USD_PER_HOUR=0.116

# OpenRouter: embeddings and optional transcription.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# auto | openrouter | deepseek. auto prefers OpenRouter, then DeepSeek.
TRANSCRIPT_PROVIDER=auto
TRANSCRIPT_MODEL=openai/whisper-large-v3

# TypeSafe Jev: typed claim gate (and later verdict decisions).
# Leave empty to use the DeepSeek gate or the local heuristic.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_CHECKABLE_THRESHOLD=0.6

# RAG cache.
RAG_TOP_K=5
RAG_MIN_SCORE=0.82
RAG_TTL_SECONDS=604800

# Cost guardrail per task, in USD.
REQUEST_BUDGET_USD=0.05

# Timeout for each AI provider request, in milliseconds.
AI_TIMEOUT_MS=20000
