# Copy this file to .env and adjust the values as needed.

# HTTP port the API listens on.
PORT=3000

# Optional. Set to a Redis/Valkey URL for the cache and short-lived task snapshots.
# Leave empty to keep both in memory.
# Example: redis://localhost:6379
REDIS_URL=

# OpenRouter: DeepSeek chat completions and embeddings.
# Leave empty to use the local heuristic/extractive fallbacks.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-chat
EMBEDDING_MODEL=openai/text-embedding-3-small

# TypeSafe Jev: typed claim gate (and later verdict decisions).
# Leave empty to use the DeepSeek gate or the local heuristic.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_CHECKABLE_THRESHOLD=0.6

# RAG cache.
RAG_TOP_K=5
RAG_MIN_SCORE=0.82
RAG_TTL_SECONDS=604800

# Cost guardrail per task, in USD.
REQUEST_BUDGET_USD=0.05

# Timeout for each AI provider request, in milliseconds.
AI_TIMEOUT_MS=20000
