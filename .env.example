# Server
PORT=3000

# The only key PRAWDOWID needs.
# Chat, claim matching, OCR and ASR all use the same DeepSeek key.
DEEPSEEK_API_KEY=

# Optional: override the API root or model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Optional: cost estimation only (USD per 1M tokens, off-peak list prices).
# DEEPSEEK_IN_USD_PER_M=0.15
# DEEPSEEK_OUT_USD_PER_M=0.6

# Storage: MySQL when set, JSON files in data/ otherwise.
# MYSQL_URL=mysql://user:pass@host:3306/prawdowid

# Optional: comma-separated browser origins allowed by CORS.
# CORS_ORIGINS=https://prawdowid.org,http://localhost:3001

# Optional runtime tuning.
# CACHE_FILE=data/cache/claims.json
# PIPELINE_DEBUG=0
# VERDICT_MODE=lean