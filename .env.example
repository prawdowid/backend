# Server
# W docker-compose mapowanie to 3000:3000, więc PORT musi zostać 3000.
PORT=3000

# Docker compose czyta ten plik jako env_file: skopiuj .env.example -> .env.
# .env nie trafia do obrazu (jest w .dockerignore).
#
# Frontend (compose) nie potrzebuje publicznego adresu backendu: przeglądarka
# woła /api/analyze na porcie 3001, a Next.js łączy się z backendem przez
# http://backend:3000 (ustawiane w docker-compose.yml).
# Opcjonalny build arg frontendu: NEXT_PUBLIC_ANALYSIS_API_URL=/api/analyze

# Ścieżki stanu (domyślnie data/...; w compose data/ jest bind mountem)
# CACHE_FILE=data/cache/claims.json
# PAGE_CACHE_DIR=data/cache/pages
# EUVD_CASES_FILE=data/euvsdisinfo/cases.ndjson
# DOC_CORPUS_FILE=corpus/corpus.jsonl

# Publiczne originy dopuszczone do bezpośrednich zapytań z przeglądarki (CORS).\n# Frontend na prawdowid.org używa własnego /api/analyze, więc CORS nie jest wymagany;\n# ustaw to, jeśli inne domeny mają wołać api.prawdowid.org bezpośrednio.\nCORS_ORIGINS=https://prawdowid.org,https://www.prawdowid.org,http://localhost:3001,http://localhost:3000\n\n# Debug (opcjonalne)
# PIPELINE_DEBUG=0
# WIKIDATA_DEBUG=0
# VERDICT_MODE=lean

# DeepSeek-OCR service (POST /ocr/extract)
DEEPSEEK_OCR_URL=

# DeepSeek ASR (falls back to OPENAI_API_KEY when unset)
DEEPSEEK_API_KEY=
# DEEPSEEK_ASR_URL=https://api.deepseek.com/v1/tools/asr

# OpenAI-compatible chat API
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter (RLCD / Jev)
OPENROUTER_API_KEY=
OPENROUTER_RLCD_MODEL=typesafe/jev-latest
# Extraction model (reasoning disabled in code)
OPENROUTER_EXTRACT_MODEL=deepseek/deepseek-v4.1-flash
# Polish-capable embeddings
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3

# Storage: MySQL when set, JSON files in data/ otherwise
# MYSQL_URL=mysql://user:pass@host:3306/prawdowid

# Optional web search for evidence discovery (Brave or Tavily)
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Discord channel lives in a separate repository and calls POST /verify

# Jina Reader (optional: override endpoint / use an API key for higher rate limits)
# JINA_READER_URL=https://r.jina.ai/

# Google Fact Check Tools API (falls back to GOOGLE_API_KEY when unset)
GOOGLE_FACT_CHECK_API_KEY=
# Optional: moderator alert webhook for repeated unanswered questions
# MODERATOR_WEBHOOK_URL=
# GOOGLE_FACT_CHECK_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search

# EUvsDisinfo MCP â€” only for building the local snapshot (scripts/ingest-euvsdisinfo.ts).
# EUvsDisinfo MCP - only for building the local snapshot (scripts/ingest-euvsdisinfo.ts).
# Runtime needs no token: it reads data/euvsdisinfo/cases.ndjson.
EUVD_TOKEN=
EUVD_MCP_URL=https://mcp.euvsd.info/mcp
EUVD_LIMIT=2000
# RESEARCH_PROXIES=http://user:pass@host:port,http://user:pass@host:port
